API_KEY=your_google_genai_api_key
LLM_MODEL=gemini-3.1-flash-lite

# Mismo PostgreSQL que C:\Dev\miuni\MiUni\docker-compose.yml
# Copiar la conexion correspondiente al .env de MiUni. Sin credenciales por defecto.
# Formato: postgresql://USUARIO:CLAVE_CODIFICADA@127.0.0.1:5433/miuni_dev
DATABASE_URL=
# Activar despues de aplicar migraciones e indexar los JSONL.
RAG_ENABLED=false
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSION=1024
RAG_EMBEDDING_BATCH_SIZE=8
RAG_MODEL_DEVICE=cpu
# Opcional: ruta absoluta; por defecto .cache/huggingface dentro del proyecto.
# RAG_MODEL_CACHE=C:/Dev/python/rag-miuni/.cache/huggingface
RAG_EMBEDDING_PIPELINE_VERSION=rag-embeddings-v1
RAG_HYBRID_SEARCH_ENABLED=true
RAG_HYDE_ENABLED=true
RAG_HYDE_SENTENCES=3
RAG_HYDE_TIMEOUT_SECONDS=15
RAG_VECTOR_TOP_N=30
RAG_LEXICAL_TOP_N=30
RAG_RRF_K=60
RAG_CONTEXT_TOP_K=8
RAG_RERANK_ENABLED=false
RAG_RERANK_PROVIDER=local_bge
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_MEASURE_RETRIEVAL_PERFORMANCE=true
RAG_EXPERIMENT_NAME=hyde_hybrid_v1
RAG_LOG_RETRIEVAL_RESULTS=false
RAG_LOG_CONTEXT_CHUNKS=false
RAG_DB_CONNECT_TIMEOUT_SECONDS=5
RAG_DB_STATEMENT_TIMEOUT_MS=30000
